# HomeRemote configuration
# Copy this file to .env and edit it for YOUR system.
# Do not commit .env.

# NAS / service host
NAS_HOST=192.168.1.10
REMOTE_PORT=8088
INTERCOM_PORT=8089
WOL_PORT=8090

# Sony STR receiver
AVR_HOST=192.168.1.50
# Zone 2 source key. Tested on STR-ZA1100ES: sat
# If your receiver uses a different source, verify it before changing this.
INTERCOM_INPUT=sat

# Sony TV
TV_HOST=192.168.1.51
TV_PSK=CHANGE_ME

# Sony Blu-ray player
BDP_HOST=192.168.1.52
BDP_MAC=CHANGE_ME
LAN_BROADCAST=192.168.1.255

# Host audio
# Find this with: pactl list short sinks
PULSE_SINK=alsa_output.pci-0000_0c_00.1.hdmi-stereo-extra1
# Find a suitable audio group with: id
# Tested UGREEN deployment used GID 10. Your host may differ.
AUDIO_GID=10

# HTTPS name used by your local DNS
REMOTE_HOSTNAME=remote.home
