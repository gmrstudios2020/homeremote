server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    location = /request.cgi {
        proxy_pass http://${AVR_HOST}/request.cgi;
        proxy_http_version 1.1;
        proxy_set_header Host ${AVR_HOST};
        proxy_set_header Content-Type application/json;
        proxy_buffering off;
        proxy_read_timeout 10s;
    }

    location = /tv/audio {
        proxy_pass http://${TV_HOST}/sony/audio;
        proxy_http_version 1.1;
        proxy_set_header Host ${TV_HOST};
        proxy_set_header Content-Type application/json;
        proxy_set_header X-Auth-PSK "${TV_PSK}";
        proxy_buffering off;
        proxy_read_timeout 10s;
    }

    location = /tv/system {
        proxy_pass http://${TV_HOST}/sony/system;
        proxy_http_version 1.1;
        proxy_set_header Host ${TV_HOST};
        proxy_set_header Content-Type application/json;
        proxy_set_header X-Auth-PSK "${TV_PSK}";
        proxy_buffering off;
        proxy_read_timeout 10s;
    }

    location = /tv/avcontent {
        proxy_pass http://${TV_HOST}/sony/avContent;
        proxy_http_version 1.1;
        proxy_set_header Host ${TV_HOST};
        proxy_set_header Content-Type application/json;
        proxy_set_header X-Auth-PSK "${TV_PSK}";
        proxy_buffering off;
        proxy_read_timeout 10s;
    }

    location = /tv/app {
        proxy_pass http://${TV_HOST}/sony/appControl;
        proxy_http_version 1.1;
        proxy_set_header Host ${TV_HOST};
        proxy_set_header Content-Type application/json;
        proxy_set_header X-Auth-PSK "${TV_PSK}";
        proxy_buffering off;
        proxy_read_timeout 10s;
    }

    location = /tv/ircc {
        proxy_pass http://${TV_HOST}/sony/ircc;
        proxy_http_version 1.1;
        proxy_set_header Host ${TV_HOST};
        proxy_set_header X-Auth-PSK "${TV_PSK}";
        proxy_buffering off;
        proxy_read_timeout 10s;
    }

    location = /bdp/ircc {
        proxy_pass http://${BDP_HOST}:50001/upnp/control/IRCC;
        proxy_http_version 1.1;
        proxy_set_header Host ${BDP_HOST}:50001;
        proxy_buffering off;
        proxy_connect_timeout 2s;
        proxy_read_timeout 4s;
    }

    location = /bdp/status {
        proxy_pass http://${BDP_HOST}:50001/Ircc.xml;
        proxy_http_version 1.1;
        proxy_set_header Host ${BDP_HOST}:50001;
        proxy_buffering off;
        proxy_connect_timeout 2s;
        proxy_read_timeout 3s;
    }

    location = /bdp/content-info {
        proxy_pass http://${BDP_HOST}:50002/getContentInformation;
        proxy_http_version 1.1;
        proxy_set_header Host ${BDP_HOST}:50002;
        proxy_set_header X-CERS-DEVICE-ID "MediaRemote:00-00-00-00-00-00";
        proxy_set_header X-CERS-DEVICE-INFO "CustomSonyRemote/1.0";
        proxy_buffering off;
        proxy_connect_timeout 2s;
        proxy_read_timeout 4s;
    }

    location = /bdp/wake {
        proxy_pass http://${NAS_HOST}:${WOL_PORT}/wake;
        proxy_http_version 1.1;
        proxy_set_header Host ${NAS_HOST}:${WOL_PORT};
        proxy_buffering off;
        proxy_read_timeout 10s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
